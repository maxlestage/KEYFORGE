<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- KeyForge peut fournir ses identifiants au remplissage automatique d'iOS. -->
	<key>com.apple.developer.authentication-services.autofill-credential-provider</key>
	<true/>
	<!-- Le premier groupe reçoit les nouveaux éléments : le coffre, partagé avec l'extension
	     KeyForgeAutoFill. Le second garde ce que l'extension ne doit pas lire (identité). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.maxlestage.KeyForge.shared</string>
		<string>$(AppIdentifierPrefix)com.maxlestage.KeyForge</string>
	</array>
</dict>
</plist>
