<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Les liens et QR codes de configuration d'un code de validation (2FA) :
	     KeyForge peut être choisi dans Réglages → Général → Remplissage automatique
	     et mots de passe → Configurer les codes dans. -->
	<!-- L'écran de lancement d'iOS : le fond d'encre et le logo au centre, exactement là
	     où l'écran de démarrage de l'app (BootView) le reprend pour l'animer. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.maxlestage.KeyForge.otpauth</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>otpauth</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
